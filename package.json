{
  "name": "resumeforge-mcp",
  "version": "0.1.0",
  "description": "Open-source MCP connector that turns any AI (Claude, ChatGPT, Cursor, Copilot, Gemini) into an ATS-optimized, JD-tailored resume engine for software engineering and every other role.",
  "type": "module",
  "bin": {
    "resumeforge-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "resume",
    "ats",
    "job-description",
    "career",
    "claude",
    "chatgpt",
    "software-engineering",
    "resume-builder"
  ],
  "author": "Vishnu Kumar Adhilakshmi Kalidas (https://github.com/Vishu-ak)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "docx": "^9.7.2",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vishu-ak/resumeforge-mcp.git"
  },
  "homepage": "https://github.com/Vishu-ak/resumeforge-mcp#readme",
  "bugs": {
    "url": "https://github.com/Vishu-ak/resumeforge-mcp/issues"
  }
}
